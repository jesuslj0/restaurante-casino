---
import { Icon } from 'astro-icon/components';

// IMPORTANTE · No filtrar reseñas por sentimiento.
// Este aviso ofrece SIEMPRE las dos vías (reseña pública en Google y canal
// privado por WhatsApp) a todos los clientes, sin preguntar antes si la
// experiencia ha sido buena o mala. Encaminar solo a los contentos hacia
// Google ("review gating") incumple las políticas de Google y la normativa
// europea de consumo sobre opiniones (Directiva Ómnibus, Ley 4/2022).
// No reintroducir un paso previo que separe opiniones positivas y negativas.

interface Props {
  /** Enlace "Escribir reseña" de tu ficha de Google. Sustituir el placeholder. */
  reviewUrl?: string;
  /** Teléfono en formato internacional para WhatsApp (sin + ni espacios). */
  phoneIntl?: string;
  /** Segundos antes de abrirse automáticamente. */
  delay?: number;
}

const {
  reviewUrl = 'https://search.google.com/local/writereview?placeid=ChIJS8vLBjSjaA0REhZDVtWw6NY',
  phoneIntl = '34621685132',
  delay = 30,
} = Astro.props;

// Texto neutro: vale igual para una felicitación que para una queja.
const waText = encodeURIComponent(
  '¡Hola! He visitado El Casino y me gustaría comentaros algo:'
);
const whatsappUrl = `https://wa.me/${phoneIntl}?text=${waText}`;
---

<aside id="review-prompt" class="rp" data-delay={delay} hidden>
  <div class="rp-panel" role="dialog" aria-labelledby="rp-title" tabindex="-1">
    <button type="button" class="rp-close" aria-label="Cerrar">
      <Icon name="lucide:x" />
    </button>

    <span class="rp-emoji" aria-hidden="true">🍽️</span>
    <h3 id="rp-title" class="rp-title">¿Qué te ha parecido El Casino?</h3>
    <p class="rp-text">
      Tu opinión nos ayuda muchísimo a seguir mejorando. Puedes dejarnos una
      reseña pública o contarnos lo que quieras en privado, como prefieras.
    </p>

    <div class="rp-actions">
      <a
        class="primary-btn rp-cta"
        data-dismiss
        href={reviewUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Dejar reseña en Google <Icon name="lucide:star" />
      </a>
      <a
        class="secondary-btn rp-cta"
        data-dismiss
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Escribirnos en privado <Icon name="simple-icons:whatsapp" />
      </a>
    </div>
  </div>
</aside>

<style>
  .rp {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    width: min(22rem, calc(100vw - 2rem));
  }

  .rp-panel {
    position: relative;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background:
      linear-gradient(160deg, rgba(201, 169, 97, 0.12), rgba(201, 169, 97, 0.02)),
      rgba(31, 21, 12, 0.92);
    border: 1px solid var(--color-accent-25);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 24px 60px -28px rgba(0, 0, 0, 0.9);
    outline: none;

    /* Estado de entrada */
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition:
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rp.is-open .rp-panel {
    opacity: 1;
    transform: none;
  }

  .rp-close {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.05);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .rp-close:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.1);
  }
  .rp-close :global(svg) { width: 1rem; height: 1rem; }

  .rp-emoji {
    font-size: 1.75rem;
    line-height: 1;
    display: block;
    margin-bottom: 0.6rem;
  }

  .rp-title {
    font-family: var(--font-serif-semibold);
    font-size: 1.2rem;
    color: var(--color-text);
    margin: 0 0 0.4rem;
    padding-right: 1.75rem;
  }

  .rp-text {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }

  /* Las dos vías, apiladas y con el mismo peso visual de bloque. */
  .rp-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .rp-cta {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 639px) {
    .rp {
      left: 1rem;
      right: 1rem;
      bottom: 6.75rem; /* deja hueco al navbar inferior en móvil */
      width: auto;
    }
  }
</style>

<script>
  const root = document.getElementById('review-prompt');
  if (root) {
    const KEY = 'rp-dismissed';
    const MAX_AGE = 1000 * 60 * 60 * 24 * 30; // 30 días
    const delay = Number(root.dataset.delay ?? '30') * 1000;

    const stored = Number(localStorage.getItem(KEY) ?? '0');
    const alreadyDismissed = stored > 0 && Date.now() - stored < MAX_AGE;

    if (!alreadyDismissed) {
      const closeBtn = root.querySelector<HTMLButtonElement>('.rp-close');
      let engaged = false; // si ya llegó a Contacto, no molestamos
      let timer: number;

      const open = () => {
        if (engaged) return;
        root.hidden = false;
        // fuerza reflow para que la transición de entrada se aplique
        requestAnimationFrame(() => root.classList.add('is-open'));
      };

      const dismiss = () => {
        root.classList.remove('is-open');
        localStorage.setItem(KEY, String(Date.now()));
        window.clearTimeout(timer);
        document.removeEventListener('keydown', onKey);
        const hide = () => (root.hidden = true);
        // espera al fin de la animación si la hay
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        reduce ? hide() : window.setTimeout(hide, 400);
      };

      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') dismiss();
      };

      timer = window.setTimeout(open, delay);
      document.addEventListener('keydown', onKey);

      closeBtn?.addEventListener('click', dismiss);

      // Al pulsar cualquiera de las dos vías, no volver a mostrarlo
      root.querySelectorAll<HTMLElement>('[data-dismiss]').forEach((el) => {
        el.addEventListener('click', () => {
          localStorage.setItem(KEY, String(Date.now()));
        });
      });

      // Si el usuario ya ha visto la sección de contacto, no abrir
      const contact = document.getElementById('contacto');
      if (contact && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              engaged = true;
              window.clearTimeout(timer);
              io.disconnect();
            }
          });
        });
        io.observe(contact);
      }
    }
  }
</script>
