---
// ============================================================
//  /blog/pagina/<n> — de la 2 en adelante
// ------------------------------------------------------------
//  La 1 no se genera: es /blog. Tener las dos sería el mismo
//  listado en dos URLs peleándose por la misma búsqueda.
// ============================================================
import '../../../styles/blog.css';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlogListado from '../../../components/blog/BlogListado.astro';
import { paginar, POR_PAGINA } from '../../../lib/blog';
import { publicados, destacada } from '../../../lib/blog-posts';

export async function getStaticPaths() {
  const posts = await publicados();
  const resto = posts.filter((p) => p.id !== destacada(posts)?.id);
  const total = Math.max(1, Math.ceil(resto.length / POR_PAGINA));
  return Array.from({ length: total - 1 }, (_, i) => ({ params: { n: String(i + 2) } }));
}

const n = Number(Astro.params.n);
const posts = await publicados();
const destacado = destacada(posts);
const pagina = paginar(posts.filter((p) => p.id !== destacado?.id), n)!;

const props = {
  restaurantName: 'El Casino',
  location: 'Plaza Mayor, Nº5 - El Bonillo (AB)',
};
const socialProps = {
  facebookUsername: 'elcasino',
  instagramUsername: 'casinoelbonillo',
  xUsername: 'el_casino',
};
---

<Layout
  title={`Blog · página ${n} · El Casino de El Bonillo`}
  description={`Página ${n} del blog de El Casino: almuerzos, menús, tapeo, celebraciones y planes en la Plaza Mayor de El Bonillo.`}
>
  <Header slot="header" />

  <header class="bl-head">
    <div class="bl-head-inner">
      <nav class="bl-migas" aria-label="Migas de pan">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a><span aria-hidden="true">/</span>
        <span aria-current="page">Página {n}</span>
      </nav>
      <p class="eyebrow">• El blog del Casino · página {n} •</p>
      <h1 class="bl-title">Almuerzos, menús y tapeo <span class="title-highlight">en la Plaza Mayor</span></h1>
    </div>
  </header>

  <div class="bl-wrap">
    <BlogListado pagina={pagina} destacado={destacado} />
  </div>

  <Footer
    slot="footer"
    restaurantName={props.restaurantName}
    location={props.location}
    facebookUsername={socialProps.facebookUsername}
    instagramUsername={socialProps.instagramUsername}
    xUsername={socialProps.xUsername}
  />
</Layout>
