---
// ============================================================
//  /blog — el índice
// ------------------------------------------------------------
//  Solo se llega desde el footer (y desde Google): a propósito no
//  está en el navbar. Quien entra al blog viene de una búsqueda,
//  y al que ya está en la web lo que le interesa es la carta.
// ============================================================
import '../../styles/blog.css';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogListado from '../../components/blog/BlogListado.astro';
import { paginar, fechaISO } from '../../lib/blog';
import { publicados, destacada } from '../../lib/blog-posts';

const posts = await publicados();
const destacado = destacada(posts);
const pagina = paginar(posts.filter((p) => p.id !== destacado?.id), 1)!;

const site = (Astro.site ?? Astro.url).origin;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'El blog de El Casino de El Bonillo',
    description: 'Almuerzos, menús, tapeo, celebraciones y planes en la Plaza Mayor de El Bonillo.',
    url: `${site}/blog/`,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.titulo,
      url: `${site}/blog/${p.id}/`,
      datePublished: fechaISO(p.data.fecha),
    })),
  },
];

const props = {
  restaurantName: 'El Casino',
  location: 'Plaza Mayor, Nº5 - El Bonillo (AB)',
};
const socialProps = {
  facebookUsername: 'elcasino',
  instagramUsername: 'casinoelbonillo',
  xUsername: 'el_casino',
};
---

<Layout
  title="Blog: almuerzos, menús y tapeo en El Bonillo · El Casino"
  description="Almuerzos de 9:30 a 11:30, menú del día, tapeo de fin de semana, celebraciones y planes en la Plaza Mayor de El Bonillo. Todo lo que conviene saber del Casino."
>
  <Header slot="header" />

  <header class="bl-head">
    <div class="bl-head-inner">
      <nav class="bl-migas" aria-label="Migas de pan">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Blog</span>
      </nav>
      <p class="eyebrow">• El blog del Casino •</p>
      <h1 class="bl-title">Almuerzos, menús y tapeo <span class="title-highlight">en la Plaza Mayor</span></h1>
      <p class="bl-lead">
        Lo que nos preguntáis en la barra: a qué hora son los almuerzos, cómo va el menú del día,
        cómo celebrar una comunión en El Bonillo y qué hacer por el pueblo y por Campo de Montiel.
      </p>
    </div>
  </header>

  <div class="bl-wrap">
    <BlogListado pagina={pagina} destacado={destacado} />
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemas)} />

  <Footer
    slot="footer"
    restaurantName={props.restaurantName}
    location={props.location}
    facebookUsername={socialProps.facebookUsername}
    instagramUsername={socialProps.instagramUsername}
    xUsername={socialProps.xUsername}
  />
</Layout>
